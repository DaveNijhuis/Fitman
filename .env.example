# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: changing this key invalidates all existing login sessions.
SECRET_KEY=change-me

# How many days a login token stays valid before you need to log in again
JWT_EXPIRE_DAYS=7

# User credentials are now stored in the database.
# On first launch, visit /setup to create the admin account.
# ADMIN_USERNAME and ADMIN_PASSWORD are no longer used.

# ── Database ──────────────────────────────────────────────────────────────────
# Production database password. Required: the production stack refuses to start
# without it. Use a hex value, since it goes into a connection URL:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# Connection string for the dev stack and for running the backend outside
# Docker (use localhost there). The production stack ignores this and builds
# its own from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://fitman:fitman@postgres:5432/fitman

# Connection pool tuning — defaults are fine for a single-user self-hosted app.
# Only change these if you observe "queue overflow" errors under concurrent load.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Ports (production stack) ───────────────────────────────────────────────────
# Where docker-compose.yml publishes the app. The defaults suit a server with
# nothing else on port 80; see "Ports" in README.md for conflicts, and for
# running behind a reverse proxy you already have.
#
# Web app: a port, or an address and port to accept connections from this
# machine only (e.g. 127.0.0.1:8081 behind a reverse proxy on the same host).
# FITMAN_HTTP_PORT=80
#
# Database, always bound to 127.0.0.1 (server and SSH tunnels only). A port only.
# FITMAN_DB_PORT=5433

# ── Smart scale ───────────────────────────────────────────────────────────────
# The e.volve / iCOMON smart scale integration is opt-in. Off, Fitman offers
# manual weight entry only and exposes nothing scale-related. See SCALE.md.
SCALE_ENABLED=false
# Fallbacks for body-composition formulas when neither the request nor the
# user's profile supplies age, height or sex (sex: 1 = male, 0 = female).
# All optional. See SCALE.md.
SCALE_AGE=30
SCALE_HEIGHT_CM=180
SCALE_SEX=1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Which other origins may call the backend directly. Normally none do: in
# production nginx proxies /api on the page's own origin, and in development the
# Vite dev server does the same. Both are the same origin as the page, so this
# only matters if you serve the frontend from somewhere else.
CORS_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
# Log output format. The default emits structured JSON, one object per line,
# each carrying the request_id that also appears in the X-Request-ID response
# header — so a user-reported request can be traced through the logs.
# Set to "text" for human-readable output during local development.
FITMAN_LOG_FORMAT=json

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Set to true only for the E2E stack, which logs in faster than the limits allow.
RATE_LIMIT_DISABLED=false
